{
  "name": "bigcommerce-store-api",
  "version": "0.0.8",
  "description": "BigCommerce Store API Client",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "rimraf lib && tsc",
    "pull:references": "node ./scripts/pull-references.js",
    "clean": "rimraf lib",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:bun": "bun test --timeout 30000 --parallel"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "jest": {
    "globalSetup": "<rootDir>/jest/global-setup.js",
    "testTimeout": 30000
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iceleo-com/bigcommerce-store-api.git"
  },
  "keywords": [
    "bigcommerce",
    "api",
    "client",
    "store",
    "remote",
    "management",
    "catalog"
  ],
  "author": "Brat Vu",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/iceleo-com/bigcommerce-store-api/issues"
  },
  "homepage": "https://github.com/iceleo-com/bigcommerce-store-api#readme",
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/node": "^22.10.2",
    "jest": "^30.5.2",
    "msw": "^2.15.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "yaml": "^2.7.0"
  },
  "dependencies": {
    "axios": "^1.20.0"
  }
}
