import RequestService from '../helpers/request/request-service';
import type { RequestSuccessResponse, RequestErrorResponse } from '../helpers/request/request-service.types';
import * as {{{className}}}Specs from '../generated/{{{fileName}}}';
export * as {{{className}}}Specs from '../generated/{{{fileName}}}';

export class {{{className}}} {
    private readonly request: RequestService;

    constructor(request: RequestService) {
        this.request = request;
    }
    {{#each properties}}

    /**
     * {{{summary}}}
     *
     * {{{description}}}
     */
    {{{name}}}(
        {{#each parameters}}
        {{{normalizedName}}}: {{{type}}},
        {{/each}}
        {{#if requestBody}}requestBody: {{{../className}}}Specs.{{{requestTypeName}}}['body'],{{/if}}
        {{#if (gt queries.length 0)}}query?: {{{../className}}}Specs.{{{requestTypeName}}}['query'],{{/if}}
    ) {
        return this.request.{{{method}}}<
            {{~#if successResponses.length~}}
                {{~#if (gt successResponses.length 1)~}}({{~/if~}}
                {{~#each successResponses~}}
                    RequestSuccessResponse<{{{status}}}, Required<{{{../../className}}}Specs.{{{type}}}>>{{#unless @last}} | {{/unless~}}
                {{~/each~}}
                {{~#if (gt successResponses.length 1)~}}){{~/if~}}
            {{~else~}}
                RequestSuccessResponse<200, void>
            {{~/if~}}
            ,
            {{~#if errorResponses.length~}}
                {{~#if (gt errorResponses.length 1)~}}({{~/if~}}
                {{~#each errorResponses~}}
                    RequestErrorResponse<{{{status}}}, Required<{{{../../className}}}Specs.{{{type}}}>>{{#unless @last}} | {{/unless~}}
                {{~/each~}}
                {{~#if (gt errorResponses.length 1)~}}){{~/if~}}
            {{~else~}}
                RequestErrorResponse<400, void>
            {{~/if~}}
        >({
            path: {{{path}}},
            {{#if requestBody.mediaType}}contentType: '{{{requestBody.mediaType}}}',{{/if}}
            {{#if requestBody}}body: requestBody,{{/if}}
            {{#if queries.length}}query,{{/if}}
        });
    }
    {{/each}}
}
